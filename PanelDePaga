        EstadoKey.Text = mensaje
        EstadoKey.TextColor3 = Color3.fromRGB(0, 255, 136)
        KeyValida = true
        task.wait(1)
        CrearPanelPrincipal()
    else
        EstadoKey.Text = mensaje
        EstadoKey.TextColor3 = Color3.fromRGB(255, 60, 90)
        task.wait(2.5)
        EstadoKey.Text = ""
    end
end)

