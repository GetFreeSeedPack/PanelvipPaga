    -- =============================================
    -- 🌈 HOLOGRAMA — ANIMACIÓN CONTINUA ARCOÍRIS ✅
    -- =============================================
    local function CrearHolograma(jugador)
        if not HologramaActivo then return end
        if jugador == LocalPlayer then return end
        local personaje = jugador.Character
        if not personaje then return end
        if Highlights[jugador] then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "HologramaRainbow"
        highlight.FillColor = RainbowColor(0)
        highlight.OutlineColor = RainbowColor(0.5)
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = personaje
        highlight.Parent = personaje
        Highlights[jugador] = highlight
    end

    local function EliminarHolograma(jugador)
        if Highlights[jugador] then
            Highlights[jugador]:Destroy()
            Highlights[jugador] = nil
        end
    end

    local function ActualizarTodosHologramas()
        for _, jugador in ipairs(Players:GetPlayers()) do
            if HologramaActivo then
                CrearHolograma(jugador)
            else
                EliminarHolograma(jugador)
            end
        end
    end

    -- ✅ ANIMACIÓN: CAMBIA DE COLOR SIN PARAR
    local function IniciarAnimacionHolograma()
        if ConexionAnimacionHolo then ConexionAnimacionHolo:Disconnect() end
        ConexionAnimacionHolo = RunService.RenderStepped:Connect(function()
            if not HologramaActivo then return end
            for jugador, highlight in pairs(Highlights) do
                if highlight then
                    highlight.FillColor = RainbowColor(0)      -- 🔴🟡🟢🔵🟣 Cambia sin parar
                    highlight.OutlineColor = RainbowColor(0.5)   -- Color diferente para el borde
                end
            end
        end)
    end

    -- =============================================
    -- 🌈 ESP LÍNEA — ARCOÍRIS
    -- =============================================
    local function CrearLineaESP(jugador)
        if not ESPActivo then return end
        if jugador == LocalPlayer then return end
        if LineasESP[jugador] then return end
        local linea = Drawing.new("Line")
        linea.Thickness = 2
        linea.Transparency = 1
        linea.Color = RainbowColor(0)
        linea.Visible = false
        LineasESP[jugador] = linea
    end

    local function EliminarLineaESP(jugador)
        if LineasESP[jugador] then
            LineasESP[jugador]:Remove()
            LineasESP[jugador] = nil
        end
    end

    local function ActualizarESP()
        if not ESPActivo then
            for _, linea in pairs(LineasESP) do
                linea.Visible = false
            end
            return
        end
        local miChar = LocalPlayer.Character
        if not miChar then return end
        local miHRP = miChar:FindFirstChild("HumanoidRootPart")
        if not miHRP then return end
        for _, jugador in ipairs(Players:GetPlayers()) do
            if jugador == LocalPlayer then continue end
            CrearLineaESP(jugador)
            local personaje = jugador.Character
            if not personaje then continue end
            local hrp = personaje:FindFirstChild("HumanoidRootPart")
            local cabeza = personaje:FindFirstChild("Head")
            if not hrp or not cabeza then continue end
            local linea = LineasESP[jugador]
            local vectorInicio = Camera:WorldToViewportPoint(miHRP.Position)
            local vectorFin = Camera:WorldToViewportPoint(cabeza.Position)
            if vectorFin.Z > 0 then
                linea.From = Vector2.new(vectorInicio.X, vectorInicio.Y)
                linea.To = Vector2.new(vectorFin.X, vectorFin.Y)
                linea.Color = RainbowColor(0)  -- ✅ La línea también cambia de color
                linea.Visible = true
            else
                linea.Visible = false
            end
        end
    end

    -- =============================================
    -- 🚀 NOCLIP
    -- =============================================
    local function ActualizarNoClip()
        if not NoClipActivo then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, parte in ipairs(char:GetDescendants()) do
            if parte:IsA("BasePart") then
                parte.CanCollide = false
            end
        end
    end

    -- =============================================
    -- 🔘 BOTONES
    -- =============================================
    BtnHolograma.MouseButton1Click:Connect(function()
        HologramaActivo = not HologramaActivo
        BtnHolograma.Text = HologramaActivo and "🌈 HOLOGRAMA: ON ✅" or "🌈 HOLOGRAMA: OFF"
        BtnHolograma.BackgroundColor3 = HologramaActivo and RainbowColor(0) or Color3.fromRGB(30, 30, 60)
        ActualizarTodosHologramas()
        if HologramaActivo then
            IniciarAnimacionHolograma()  -- ✅ Empieza a cambiar de color
        else
            if ConexionAnimacionHolo then ConexionAnimacionHolo:Disconnect() end
        end
    end)

    BtnESP.MouseButton1Click:Connect(function()
        ESPActivo = not ESPActivo
        BtnESP.Text = ESPActivo and "🌈 ESP LÍNEA: ON ✅" or "🌈 ESP LÍNEA: OFF"
        BtnESP.BackgroundColor3 = ESPActivo and RainbowColor(0) or Color3.fromRGB(30, 30, 60)
        if ESPActivo then
            ConexionESP = RunService.RenderStepped:Connect(ActualizarESP)
        else
            if ConexionESP then ConexionESP:Disconnect() end
            for _, linea in pairs(LineasESP) do
                linea.Visible = false
            end
        end
    end)

    BtnNoClip.MouseButton1Click:Connect(function()
        NoClipActivo = not NoClipActivo
        BtnNoClip.Text = NoClipActivo and "🚀 NOCLIP: ON ✅" or "🚀 NOCLIP: OFF"
        BtnNoClip.BackgroundColor3 = NoClipActivo and RainbowColor(0) or Color3.fromRGB(30, 30, 60)
        if NoClipActivo then
            ConexionNoClip = RunService.Stepped:Connect(ActualizarNoClip)
        else
            if ConexionNoClip then ConexionNoClip:Disconnect() end
            local char = LocalPlayer.Character
            if char then
                for _, parte in ipairs(char:GetDescendants()) do
                    if parte:IsA("BasePart") then
                        parte.CanCollide = true
                    end
                end
            end
        end
    end)

    -- =============================================
    -- 🔄 DETECTAR JUGADORES NUEVOS
    -- =============================================
    Players.PlayerAdded:Connect(function(jugador)
        jugador.CharacterAdded:Connect(function()
            task.wait(0.5)
            if HologramaActivo then CrearHolograma(jugador) end
            if ESPActivo then CrearLineaESP(jugador) end
        end)
    end)

    Players.PlayerRemoving:Connect(function(jugador)
        EliminarHolograma(jugador)
        EliminarLineaESP(jugador)
    end)

    -- 🔄 ANIMACIÓN DE BORDES Y BOTONES
    task.spawn(function()
        while true do
            task.wait(0.05)
            Panel.BorderColor3 = RainbowColor(0)
            BarraTitulo.BackgroundColor3 = RainbowColor(0)
            BtnHolograma.BorderColor3 = RainbowColor(0)
            BtnESP.BorderColor3 = RainbowColor(0)
            BtnNoClip.BorderColor3 = RainbowColor(0)
            BtnRestaurar.BackgroundColor3 = RainbowColor(0)
        end
    end)

    task.wait(1)
    ActualizarTodosHologramas()
    print("🌈 PANEL CARGADO — HOLOGRAMA ANIMADO ✅")
end

