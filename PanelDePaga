-- 🔐 SISTEMA DE KEY
local KeyValida = false
local function ValidarKey(key)
    key = string.upper(string.gsub(key or "", "%s+", ""))
    if #key ~= 20 or string.sub(key, 1, 4) ~= "FREE" then
        return false, "❌ Formato: FREE + 16 NÚMEROS"
    end
    local numeros = string.sub(key, 5)
    if not string.match(numeros, "^%d+$") then
        return false, "❌ Solo números después de FREE"
    end
    return true, "✅ KEY ACEPTADA — BIENVENIDO!"
end

