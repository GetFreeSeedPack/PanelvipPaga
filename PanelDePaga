-- 🌈 FUNCIÓN DE COLOR ARCOÍRIS — CÁMBIA SIN PARAR
local function RainbowColor(offset)
    return Color3.fromHSV((os.clock() + (offset or 0)) % 6 / 6, 1, 1)
end

